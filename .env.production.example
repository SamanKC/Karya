# Karya production environment variables
# Copy to .env and fill in values before running docker-compose.prod.yml

# ─── Database ──────────────────────────────────────────────
# Used by docker-compose to create the MySQL container
MYSQL_ROOT_PASSWORD=your-root-password
MYSQL_USER=karya
MYSQL_PASSWORD=your-secure-password

# Prisma connection string (auto-set by docker-compose, override for external DB)
# DATABASE_URL=mysql://karya:your-secure-password@mysql:3306/karya

# ─── JWT Authentication (RS256) ────────────────────────────
# Generate keys:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then set the PEM contents with literal \n for line breaks:
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ─── App ───────────────────────────────────────────────────
PORT=3001
# CLIENT_URL is used for CORS and email verification links.
# For the Docker setup where the server serves both API and client,
# set this to the public URL of your deployment.
CLIENT_URL=https://your-domain.com

# ─── Logging (optional) ───────────────────────────────────
# LOG_LEVEL=info  # debug | info | warn | error
