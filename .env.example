# Database
DATABASE_URL="mysql://karya:karya_dev@localhost:3306/karya"

# JWT Authentication (RS256)
# Generate a dev key pair:
#   mkdir -p keys
#   openssl genrsa -out keys/dev-private.pem 2048
#   openssl rsa -in keys/dev-private.pem -pubout -out keys/dev-public.pem
# Then paste the PEM contents here with literal \n for newlines:
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Server
PORT=3001
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# Email (MVP: logs verification links to console)
# For production, swap for a real email service.
